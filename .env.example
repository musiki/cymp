# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Authentication Secret (generate with: openssl rand -hex 32)
AUTH_SECRET="your-random-secret-here"

# Better Auth URL
# Development:
BETTER_AUTH_URL="http://localhost:4321"
# Production (update with your Vercel domain):
# BETTER_AUTH_URL="https://your-domain.vercel.app"

# Astro DB - Production (Turso)
# Get these after running: bash scripts/setup-turso.sh
# ASTRO_DB_REMOTE_URL="libsql://cymp-production-xxx.turso.io"
# ASTRO_STUDIO_APP_TOKEN="your-turso-token-here"

# Note: For local development, these remote DB variables are optional.
# Astro DB will use a local SQLite file (.astro/content.db) automatically.
