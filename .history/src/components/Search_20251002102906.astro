
--- 
// No server-side logic needed for this component 
--- 

<div class="search-container"> 
  <input type="search" id="search-input" placeholder="Buscar..." /> 
  <ul id="search-results"></ul> 
</div> 

<style> 
  .search-container { 
    position: relative; 
  } 
  #search-input { 
    width: 100%; 
    padding: 0.5rem; 
    border-radius: 4px; 
    border: 1px solid #ccc; 
  } 
  #search-results { 
    position: absolute; 
    top: 100%; 
    left: 0; 
    right: 0; 
    background: white; 
    border: 1px solid #ccc; 
    border-top: none; 
    list-style: none; 
    padding: 0; 
    margin: 0; 
    max-height: 300px; 
    overflow-y: auto; 
    z-index: 10; 
  } 
  #search-results li a { 
    display: block; 
    padding: 0.5rem; 
    text-decoration: none; 
    color: #333; 
  } 
  #search-results li a:hover { 
    background-color: #f0f0f0; 
  } 
</style> 

<script> 
  import Fuse from 'fuse.js'; 

  let fuse; 
  const searchInput = document.getElementById('search-input') as HTMLInputElement; 
  const searchResults = document.getElementById('search-results') as HTMLUListElement; 

  // Fetch the search index 
  async function initFuse() { 
    const response = await fetch('/search-index.json'); 
    const searchIndex = await response.json(); 
    fuse = new Fuse(searchIndex, { 
      keys: ['title', 'description'], 
      includeScore: true, 
      threshold: 0.4, // Adjust for more/less fuzzy results 
    }); 
  } 

  initFuse(); 

  searchInput.addEventListener('input', () => { 
    if (!fuse) return; 

    const query = searchInput.value; 
    if (query.length < 2) { 
      searchResults.innerHTML = ''; 
      return; 
    } 

    const results = fuse.search(query).slice(0, 10); // Show top 10 results 
    searchResults.innerHTML = results 
      .map(result => `<li><a href="${result.item.slug}">${result.item.title}</a></li>`) 
      .join(''); 
  }); 

  // Hide results when clicking outside 
  document.addEventListener('click', (e) => { 
    if (!searchResults.contains(e.target as Node)) { 
      searchResults.innerHTML = ''; 
    } 
  }); 
</script>
