---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';

// auth-astro populates Astro.locals.session
const session = Astro.locals.session;
const user = session?.user;
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/about">Acerca</HeaderLink>
			{user && <HeaderLink href="/dashboard">Dashboard</HeaderLink>}
		</div>
		<Search />
		<div class="social-links">
			<a href="https://github.com/musiki/cym" target="_blank">
				<span class="sr-only">repositorio de cym</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
				<svg class="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/>
				</svg>
				<svg class="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
					<path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/>
				</svg>
			</button>
			<div class="auth-links">
				{user ? (
					<a href="/api/auth/logout">Logout</a>
				) : (
					<a href="/login">Login</a>
				)}
			</div>
		</div>
	</nav>
</header>
<script>
	const handleToggleClick = () => {
		const element = document.documentElement;
		element.classList.toggle('dark');

		const isDark = element.classList.contains('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	};

	document.getElementById('theme-toggle')?.addEventListener('click', handleToggleClick);
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: none;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.auth-links a {
		padding: 0.3em 0.8em;
		border: 1px solid var(--c-border);
		border-radius: 6px;
	}
	.auth-links a:hover {
		background-color: var(--c-bg-mute);
	}
	.social-links a {
		display: flex;
		align-items: center;
	}
	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.2s;
	}
	.theme-toggle:hover {
		opacity: 0.7;
	}
	.theme-toggle svg {
		width: 24px;
		height: 24px;
	}
	.sun {
		display: block;
	}
	.moon {
		display: none;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}

	/* Dark mode styles */
	:global(.dark) header {
		background: rgb(30 30 30);
	}
	:global(.dark) .auth-links a:hover {
		background-color: #2b2b2f;
	}
	:global(.dark) nav a {
		color: rgb(var(--black));
	}
	:global(.dark) .theme-toggle {
		color: rgb(var(--black));
	}
	:global(.dark) .sun {
		display: none;
	}
	:global(.dark) .moon {
		display: block;
	}
</style>
