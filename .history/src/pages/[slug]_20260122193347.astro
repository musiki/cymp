---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import WikiLayout from '../layouts/WikiLayout.astro';

const { slug } = Astro.params;

// Get all content entries
const allContent = await getCollection('content');

// Find entry by matching the slug path
const entry = allContent.find(item => {
  const target = decodeURIComponent(slug || '').toLowerCase();
  const targetNormalized = target.replace(/-/g, ' '); // Handle kebab-case requests (e.g. /my-note -> "my note")
  const id = item.id.toLowerCase();
  // Flattened check: match filename (ignoring folder path)
  const filename = item.id.split('/').pop()?.replace(/\.[^/.]+$/, '').toLowerCase();
  
  return filename === target || filename === targetNormalized || id === target || id.replace(/\.[^/.]+$/, '') === target;
});

if (!entry) {
  return Astro.redirect('/404');
}

// Render the content
const { Content, headings } = await render(entry);

// Resolve title: Frontmatter > Filename
const title = entry.data.title || entry.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || 'Untitled';
---

<WikiLayout
  title={title}
  description={entry.data.description || entry.data.subtitle || ''}
>
  <Content />
</WikiLayout>