---
// src/pages/dashboard.astro
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { db, User, Enrollment, Submission, eq } from 'astro:db';

// --- AUTHENTICATION ---
const session = Astro.locals.session as any;
const currentUser = session?.user;

if (!currentUser?.email) {
  return Astro.redirect('/login?redirect=/dashboard');
}

// Get user details from DB to check role using email
const [dbUser] = await db.select().from(User).where(eq(User.email, currentUser.email));

if (!dbUser) {
  return Astro.redirect('/login?redirect=/dashboard');
}

const isTeacher = dbUser.role === 'teacher';

import '../styles/theme.css';

// --- TEACHER DASHBOARD ---
let allUsers, allEnrollments, allSubmissions;

if (isTeacher) {
  // Query all data for teacher view
  allUsers = await db.select().from(User);
  allEnrollments = await db.select().from(Enrollment);
  allSubmissions = await db.select().from(Submission);
}

// --- STUDENT DASHBOARD ---
const userEnrollments = await db.select({ courseId: Enrollment.courseId })
  .from(Enrollment)
  .where(eq(Enrollment.userId, dbUser.id));

const enrolledCourseIds = userEnrollments.map(e => e.courseId);

// Scan content for enrolled courses
const ROOT = path.resolve('src/content');
const files:any[] = [];
(function walk(dir: string) {
  if (!fs.existsSync(dir)) return;
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) {
      const courseId = path.basename(p);
      if (enrolledCourseIds.includes(courseId)) {
        walk(p);
      }
    } else if (/\.(md|mdx)$/i.test(e.name)) {
      files.push(p);
    }
  }
})(ROOT);

const entries = await Promise.all(
  files.map(async (abs) => {
    const rel = abs.slice(ROOT.length + 1);
    const posix = rel.split(path.sep).join('/');
    const slug = posix.replace(/\.(md|mdx)$/i, '');
    const segs = slug.split('/');
    
    const raw = fs.readFileSync(abs, 'utf8');
    const fm = matter(raw);

    return {
      slug,
      root: segs[0],
      title: fm.data.title || segs[segs.length - 1],
      img: fm.data.img || fm.data.coverUrl || fm.data.image || fm.data.photo || '',
      tags: Array.isArray(fm.data.tags)
        ? fm.data.tags
        : (fm.data.tags ? String(fm.data.tags).split(',').map((s:string) => s.trim()) : []),
    };
  })
);

const validEntries = entries.filter(Boolean);

const groupedEntries = validEntries.reduce((acc:any, entry:any) => {
  const { root } = entry;
  (acc[root] ||= []).push(entry);
  return acc;
}, {});
---

<html lang="es">
  <head>
    <BaseHead title={isTeacher ? "Panel de Administración" : "Mis Cursos"} description="Plataforma de aprendizaje" />
    <meta charset="utf-8" />
    <style is:inline>
      .wrap { max-width: 1200px; margin: 0 auto; padding: 1rem; }
      .group-title { margin-top: 3rem; margin-bottom: 1rem; border-bottom: 1px solid var(--c-border); padding-bottom: 0.5rem; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
      .card { border: 1px solid var(--c-border); border-radius: 8px; overflow: hidden; background: var(--c-bg); display: flex; flex-direction: column; text-decoration: none; color: var(--c-fg); position: relative; }
      .card:hover { border-color: var(--c-link); }
      .card img { width: 100%; height: 140px; object-fit: cover; display: block; flex-shrink: 0; }
      .card-body { padding: 0.5rem 0.75rem; flex: 1; display: flex; flex-direction: column; min-height: 0; }
      .title { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.3; }
      .tags { display: flex; gap: .25rem; flex-wrap: wrap; margin-top: auto; padding-top: .5rem; }
      .tag { font-size: .7rem; padding: .1rem .4rem; border: 1px solid var(--c-border); border-radius: 6px; text-decoration: none; display: inline-block; }
      
      /* Teacher Dashboard Styles */
      .admin-table { width: 100%; border-collapse: collapse; margin-top: 2rem; font-size: 0.9rem; }
      .admin-table th { background: var(--c-bg-mute); padding: 0.75rem; text-align: left; border-bottom: 2px solid var(--c-border); font-weight: 600; }
      .admin-table td { padding: 0.75rem; border-bottom: 1px solid var(--c-border); }
      .admin-table tr:hover { background: var(--c-bg-mute); }
      .role-badge { padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; }
      .role-teacher { background: #e3f2fd; color: #1976d2; }
      .role-student { background: #f3e5f5; color: #7b1fa2; }
      .enrollment-list { font-size: 0.85rem; }
      .enrollment-item { display: inline-block; padding: 0.2rem 0.5rem; background: var(--c-bg-mute); border-radius: 4px; margin: 0.2rem; }
      .submission-count { font-weight: 600; color: var(--c-link); }
      .grade-link { color: var(--c-link); text-decoration: none; padding: 0.25rem 0.5rem; border-radius: 4px; border: 1px solid var(--c-border); font-size: 0.8rem; }
      .grade-link:hover { background: var(--c-bg-mute); }
      .status-pending { color: #f57c00; }
      .status-graded { color: #388e3c; }
      .tabs { display: flex; gap: 1rem; border-bottom: 2px solid var(--c-border); margin-bottom: 2rem; }
      .tab { padding: 0.75rem 1.5rem; cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; font-weight: 500; transition: all 0.2s; }
      .tab:hover { background: var(--c-bg-mute); }
      .tab.active { border-bottom-color: var(--c-link); color: var(--c-link); }
    </style>
  </head>
  <body>
    <Header />
    <main class="wrap">
      {isTeacher ? (
        <>
          <h1>👨‍🏫 Panel de Administración</h1>
          <p>Gestión de usuarios, inscripciones y calificaciones</p>

          <div class="tabs">
            <div class="tab active" data-tab="users">Usuarios</div>
            <div class="tab" data-tab="enrollments">Inscripciones</div>
            <div class="tab" data-tab="submissions">Entregas</div>
          </div>

          <div id="users-content">
            <h2>📋 Lista de Usuarios</h2>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Email</th>
                  <th>Rol</th>
                  <th>Cursos Inscritos</th>
                  <th>Entregas</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                {allUsers.map((user:any) => {
                  const userEnrolls = allEnrollments.filter((e:any) => e.userId === user.id);
                  const userSubs = allSubmissions.filter((s:any) => s.userId === user.id);
                  const pendingSubs = userSubs.filter((s:any) => !s.gradedAt);
                  const gradedSubs = userSubs.filter((s:any) => s.gradedAt);
                  
                  return (
                    <tr>
                      <td>{user.name}</td>
                      <td style="font-size: 0.85rem; color: var(--c-fg-dim);">{user.email}</td>
                      <td>
                        <span class:list={['role-badge', user.role === 'teacher' ? 'role-teacher' : 'role-student']}>
                          {user.role === 'teacher' ? '👨‍🏫 Teacher' : '👨‍🎓 Student'}
                        </span>
                      </td>
                      <td>
                        <div class="enrollment-list">
                          {userEnrolls.length > 0 ? (
                            userEnrolls.map((e:any) => (
                              <span class="enrollment-item">{e.courseId}</span>
                            ))
                          ) : (
                            <span style="color: var(--c-fg-dim); font-size: 0.85rem;">Sin inscripciones</span>
                          )}
                        </div>
                      </td>
                      <td>
                        <div>
                          <span class="submission-count">{userSubs.length}</span> total
                          {pendingSubs.length > 0 && (
                            <span class="status-pending"> • {pendingSubs.length} pendientes</span>
                          )}
                          {gradedSubs.length > 0 && (
                            <span class="status-graded"> • {gradedSubs.length} calificadas</span>
                          )}
                        </div>
                      </td>
                      <td>
                        <a href={`/admin/user/${user.id}`} class="grade-link">Ver detalles</a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div id="enrollments-content" style="display: none;">
            <h2>📚 Inscripciones por Curso</h2>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Curso</th>
                  <th>Usuario</th>
                  <th>Rol en Curso</th>
                </tr>
              </thead>
              <tbody>
                {allEnrollments.map((enrollment:any) => {
                  const enrolledUser = allUsers.find((u:any) => u.id === enrollment.userId);
                  return (
                    <tr>
                      <td><strong>{enrollment.courseId}</strong></td>
                      <td>{enrolledUser?.name || 'Usuario desconocido'}</td>
                      <td>
                        <span class:list={['role-badge', enrollment.roleInCourse === 'teacher' ? 'role-teacher' : 'role-student']}>
                          {enrollment.roleInCourse}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div id="submissions-content" style="display: none;">
            <h2>📝 Entregas Recientes</h2>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Tarea</th>
                  <th>Intentos</th>
                  <th>Fecha</th>
                  <th>Estado</th>
                  <th>Calificación</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                {allSubmissions.map((sub:any) => {
                  const submitter = allUsers.find((u:any) => u.id === sub.userId);
                  return (
                    <tr>
                      <td>{submitter?.name || 'Usuario desconocido'}</td>
                      <td style="font-size: 0.85rem;">{sub.assignmentId}</td>
                      <td style="text-align: center;">{sub.attempts}</td>
                      <td style="font-size: 0.85rem;">
                        {new Date(sub.submittedAt).toLocaleDateString('es-ES')}
                      </td>
                      <td>
                        {sub.gradedAt ? (
                          <span class="status-graded">✓ Calificada</span>
                        ) : (
                          <span class="status-pending">⏳ Pendiente</span>
                        )}
                      </td>
                      <td style="text-align: center; font-weight: 600;">
                        {sub.score !== null ? `${sub.score}/10` : '-'}
                      </td>
                      <td>
                        <a href={`/admin/grade/${sub.id}`} class="grade-link">
                          {sub.gradedAt ? 'Ver' : 'Calificar'}
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <script>
            document.querySelectorAll('.tab').forEach(tab => {
              tab.addEventListener('click', () => {
                // Remove active from all
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('[id$="-content"]').forEach(c => c.style.display = 'none');
                
                // Add active to clicked
                tab.classList.add('active');
                const tabName = tab.getAttribute('data-tab');
                document.getElementById(`${tabName}-content`).style.display = 'block';
              });
            });
          </script>
        </>
      ) : (
        <>
          <h1>Mis Cursos</h1>
          {Object.keys(groupedEntries).length === 0 ? (
            <p>Bienvenido, {currentUser.name}. Aún no estás inscrito en ningún curso.</p>
          ) : (
            Object.entries(groupedEntries).map(([folder, entriesInFolder]:any) => (
              <section>
                <h3 class="group-title">{folder}</h3>
                <div class="gallery">
                  {entriesInFolder.map((e:any) => (
                    <a href={`/cursos/${e.slug}`} class="card" data-root={e.root}>
                      {e.img && <img src={e.img} alt={e.title} />}
                      <div class="card-body">
                        <h4 class="title">{e.title}</h4>
                        {e.tags.length > 0 && <div class="tags">{e.tags.map((t:string) => <span class="tag">{t}</span>)}</div>}
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))
          )}
        </>
      )}
    </main>
    <Footer />
  </body>
</html>
