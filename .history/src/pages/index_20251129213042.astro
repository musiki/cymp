---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import GraphModal from '../components/GraphModal.astro';

import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

import '../styles/theme.css';

// ---------- Utils ----------
function norm(s) {
  return String(s)
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // quita acentos
    .replace(/\\/g, '/')                              // backslash -> slash
    .replace(/\s+/g, ' ')                             // colapsa espacios
    .trim();
}
function encodePath(p) {
  return encodeURI(p);
}

// --- LÓGICA PÚBLICA DE CARGA DE DATOS ---
// Escanear TODO el contenido de `src/content`
const ROOT = path.resolve('src/content');
const files = [];
(function walk(dir) {
  if (!fs.existsSync(dir)) return;
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) { 
      walk(p);
    }
    else if (/\.(md|mdx)$/i.test(e.name)) {
      files.push(p);
    }
  }
})(ROOT); // Podríamos empezar a caminar desde carpetas de cursos específicos

// 3. Procesar solo los archivos a los que el usuario tiene acceso
const entries = await Promise.all(
  files.map(async (abs) => {
    const rel = abs.slice(ROOT.length + 1);
    const posix = rel.split(path.sep).join('/');
    const slug = posix.replace(/\.(md|mdx)$/i, '');
    const segs = slug.split('/');

    const raw = fs.readFileSync(abs, 'utf8');
    const fm = matter(raw);

    // Aquí puedes añadir lógica para leer el YAML y decidir si es un 'assignment'
    // y sincronizarlo con la tabla `Assignment` en la DB si es necesario.
    // Por ejemplo, `isAssignment: true` en el frontmatter.

    return {
      slug,
      root: segs[0],
      title: fm.data.title || segs[segs.length - 1],
      img: fm.data.img || fm.data.coverUrl || fm.data.image || fm.data.photo || '',
      tags: Array.isArray(fm.data.tags)
        ? fm.data.tags
        : (fm.data.tags ? String(fm.data.tags).split(',').map((s) => s.trim()) : []),
    };
  })
);

// Filtrar nulos y archivos a los que no se tiene acceso
const validEntries = entries.filter(Boolean);

// Agrupar por carpeta raíz
const groupedEntries = validEntries.reduce((acc, entry) => {
  const { root } = entry;
  (acc[root] ||= []).push(entry);
  return acc;
}, {});
---

<html lang="es">
  <head>
    <BaseHead title="Ciencia y Música | UNTREF" description="Repositorio de contenidos públicos y plataforma de aprendizaje." />
    <meta charset="utf-8" />
    <style>
      .wrap { max-width: 1000px; margin: 0 auto; padding: 1rem; }
      .group-title {
        margin-top: 3rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--c-border);
        padding-bottom: 0.5rem;
      }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
      }
      .card {
        border: 1px solid var(--c-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--c-bg);
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: var(--c-fg);
        position: relative;
      }
      .card:hover { border-color: var(--c-link); }
      .card img { 
        width: 100%; 
        height: 140px; 
        object-fit: cover; 
        display: block;
        flex-shrink: 0;
      }
      .card-body { 
        padding: 0.5rem 0.75rem; 
        flex: 1; 
        display: flex; 
        flex-direction: column;
        min-height: 0;
      }
      .title { 
        margin: 0; 
        font-size: 1rem; 
        font-weight: 600;
        line-height: 1.3;
      }
      .meta { 
        font-size: .8rem; 
        color: var(--c-subtle); 
        margin: .25rem 0;
        line-height: 1.4;
      }
      .meta a { color: var(--c-link); }
      .tags { 
        display: flex; 
        gap: .25rem; 
        flex-wrap: wrap; 
        margin-top: auto;
        padding-top: .5rem;
      }
      .tag { 
        font-size: .7rem; 
        padding: .1rem .4rem; 
        border: 1px solid var(--c-border); 
        border-radius: 6px;
        text-decoration: none;
        display: inline-block;
      }
      .wikilink-missing { color: #b00; }
    </style>
  </head>
  <body>
    <GraphModal />
    <Header />
    <main class="wrap">
      <h1>Contenidos</h1>

      {Object.entries(groupedEntries).map(([folder, entriesInFolder]) => (
        <section>
          <h3 class="group-title">{folder}</h3>
          <div class="gallery">
            {entriesInFolder.map(e => (
              <a href={`/contenidos/${e.slug}`} class="card" data-root={e.root}>
                {e.img && <img src={e.img} alt={e.title} />}
                <div class="card-body">
                  <h4 class="title">{e.title}</h4>
                  {e.tags.length > 0 && (
                    <div class="tags">
                      {e.tags.map(t => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>
