---
// src/pages/dashboard.astro
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { db, Enrollment } from 'astro:db';

// --- LÓGICA DE AUTENTICACIÓN Y DATOS PRIVADOS ---
// 1. El middleware nos dará el usuario. Si no existe, ya nos habrá redirigido.
const user = Astro.locals.auth?.user();
if (!user) {
  // Esta es una doble seguridad. El middleware es la primera línea de defensa.
  return Astro.redirect('/login?redirect=/dashboard');
}

import '../styles/theme.css';

// 2. Obtener los cursos a los que el usuario está inscrito desde la DB
const userEnrollments = await db.select({ courseId: Enrollment.courseId })
  .from(Enrollment)
  .where({ userId: user.id });

const enrolledCourseIds = userEnrollments.map(e => e.courseId);

// 3. Escanear el contenido de `src/content` y filtrar por los cursos del usuario
const ROOT = path.resolve('src/content');
const files = [];
(function walk(dir) {
  if (!fs.existsSync(dir)) return;
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) {
      const courseId = path.basename(p);
      if (enrolledCourseIds.includes(courseId)) {
        walk(p);
      }
    } else if (/\.(md|mdx)$/i.test(e.name)) {
      files.push(p);
    }
  }
})(ROOT);

// 4. Procesar solo los archivos a los que el usuario tiene acceso
const entries = await Promise.all(
  files.map(async (abs) => {
    const rel = abs.slice(ROOT.length + 1);
    const posix = rel.split(path.sep).join('/');
    const slug = posix.replace(/\.(md|mdx)$/i, '');
    const segs = slug.split('/');
    
    const raw = fs.readFileSync(abs, 'utf8');
    const fm = matter(raw);

    return {
      slug,
      root: segs[0],
      title: fm.data.title || segs[segs.length - 1],
      img: fm.data.img || fm.data.coverUrl || fm.data.image || fm.data.photo || '',
      tags: Array.isArray(fm.data.tags)
        ? fm.data.tags
        : (fm.data.tags ? String(fm.data.tags).split(',').map((s) => s.trim()) : []),
    };
  })
);

const validEntries = entries.filter(Boolean);

const groupedEntries = validEntries.reduce((acc, entry) => {
  const { root } = entry;
  (acc[root] ||= []).push(entry);
  return acc;
}, {});
---

<html lang="es">
  <head>
    <BaseHead title="Mis Cursos" description="Plataforma de aprendizaje" />
    <meta charset="utf-8" />
    <style is:inline>
      .wrap { max-width: 1000px; margin: 0 auto; padding: 1rem; }
      .group-title { margin-top: 3rem; margin-bottom: 1rem; border-bottom: 1px solid var(--c-border); padding-bottom: 0.5rem; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
      .card { border: 1px solid var(--c-border); border-radius: 8px; overflow: hidden; background: var(--c-bg); display: flex; flex-direction: column; text-decoration: none; color: var(--c-fg); position: relative; }
      .card:hover { border-color: var(--c-link); }
      .card img { width: 100%; height: 140px; object-fit: cover; display: block; flex-shrink: 0; }
      .card-body { padding: 0.5rem 0.75rem; flex: 1; display: flex; flex-direction: column; min-height: 0; }
      .title { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.3; }
      .tags { display: flex; gap: .25rem; flex-wrap: wrap; margin-top: auto; padding-top: .5rem; }
      .tag { font-size: .7rem; padding: .1rem .4rem; border: 1px solid var(--c-border); border-radius: 6px; text-decoration: none; display: inline-block; }
    </style>
  </head>
  <body>
    <Header />
    <main class="wrap">
      <h1>Mis Cursos</h1>
      {Object.keys(groupedEntries).length === 0 ? (
        <p>Bienvenido, {user.name}. Aún no estás inscrito en ningún curso.</p>
      ) : (
        Object.entries(groupedEntries).map(([folder, entriesInFolder]) => (
          <section>
            <h3 class="group-title">{folder}</h3>
            <div class="gallery">
              {entriesInFolder.map(e => (
                <a href={`/cursos/${e.slug}`} class="card" data-root={e.root}>
                  {e.img && <img src={e.img} alt={e.title} />}
                  <div class="card-body">
                    <h4 class="title">{e.title}</h4>
                    {e.tags.length > 0 && <div class="tags">{e.tags.map(t => <span class="tag">{t}</span>)}</div>}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      )}
    </main>
    <Footer />
  </body>
</html>
