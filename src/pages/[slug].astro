---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import WikiLayout from '../layouts/WikiLayout.astro';
import RevealSlidesLayout from '../layouts/RevealSlidesLayout.astro';
import { buildCourseLessonHref } from '../lib/course-routing';

const { slug } = Astro.params;
const isSlidesView = Astro.url.searchParams.get('view') === 'slides';

const toCleanSlug = (value: unknown) =>
  String(value || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

// Get all content entries
const allContent = await getCollection('content');

// Find entry by matching filename slug first
let entry = allContent.find(item => {
  const target = decodeURIComponent(slug || '').toLowerCase();
  const filename = item.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || '';
  const fileSlug = toCleanSlug(filename);
  return fileSlug === target || filename.toLowerCase() === target;
});

// Fallback by unique title slug (e.g. /generatividad-y-complejidad)
if (!entry) {
  const target = decodeURIComponent(slug || '').toLowerCase();
  const byTitle = allContent.filter((item) => toCleanSlug(item.data?.title) === target);
  if (byTitle.length === 1) {
    entry = byTitle[0];
  }
}

// Legacy fallback: if an old flat slug points to a course lesson, redirect to /cursos/...
if (!entry) {
  const target = decodeURIComponent(slug || '').toLowerCase();
  const allCourseContent = await getCollection('cursos');
  const courseLessons = allCourseContent.filter(
    (item) => !item.id.endsWith('/_index') && !item.id.endsWith('_index'),
  );

  const byFilename = courseLessons.filter((item) => {
    const filename = item.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || '';
    const fileSlug = toCleanSlug(filename);
    return fileSlug === target || filename.toLowerCase() === target;
  });

  let redirectLesson = byFilename.length === 1 ? byFilename[0] : null;
  if (!redirectLesson) {
    const byTitle = courseLessons.filter((item) => toCleanSlug(item.data?.title) === target);
    if (byTitle.length === 1) redirectLesson = byTitle[0];
  }

  if (redirectLesson) {
    const courseId = redirectLesson.id.split('/')[0] || '';
    const courseIndexEntry = allCourseContent.find((item) => item.id === `${courseId}/_index`);
    return Astro.redirect(
      buildCourseLessonHref(courseId, (courseIndexEntry?.data || {}) as Record<string, unknown>, redirectLesson),
    );
  }

  return Astro.redirect('/404');
}

// Render the content
const { Content } = await render(entry);

// Resolve title: Frontmatter > Filename
const title = entry.data.title || entry.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || 'Untitled';
const description = entry.data.description || entry.data.subtitle || '';
const tags = Array.isArray(entry.data.tags)
  ? entry.data.tags
  : entry.data.tags
    ? String(entry.data.tags).split(',').map((tag) => tag.trim()).filter(Boolean)
    : undefined;
const defaultSlideTheme = '/inc/reveal/themes/zztt-reveal.css';
const slideThemeFromData = (entry.data as Record<string, unknown>).slideTheme || (entry.data as Record<string, unknown>).revealTheme;
const slideTheme = typeof slideThemeFromData === 'string' && slideThemeFromData.trim()
  ? slideThemeFromData.trim()
  : defaultSlideTheme;
const rawPresentationTheme = (entry.data as Record<string, unknown>).theme;
const hasPresentationTheme = typeof rawPresentationTheme === 'string' && rawPresentationTheme.trim().length > 0;
const presentationHref = hasPresentationTheme ? `${Astro.url.pathname}?view=slides` : '';
---

{
  isSlidesView ? (
    <RevealSlidesLayout
      title={title}
      description={description}
      slideTheme={slideTheme}
    >
      <Content />
    </RevealSlidesLayout>
  ) : (
    <>
      <WikiLayout
        title={title}
        description={description}
        id={entry.id}
        tags={tags}
        presentationHref={presentationHref}
      >
        <Content />
      </WikiLayout>
    </>
  )
}
