---
export const prerender = false;

import { getCollection } from 'astro:content';
import WikiLayout from '../layouts/WikiLayout.astro';

const { tag } = Astro.params;
const allContent = await getCollection('content');

// Filter posts by tag
const posts = allContent.filter(post => {
  const tags = post.data.tags || [];
  // Handle both array of strings and comma-separated string
  const postTags = Array.isArray(tags) 
    ? tags 
    : String(tags).split(',').map(t => t.trim());
    
  return postTags.some(t => t.toLowerCase() === tag?.toLowerCase());
});

if (!posts.length) {
  return Astro.redirect('/404');
}

const title = `Tag: ${tag}`;
---

<WikiLayout title={title} description={`Content tagged with ${tag}`}>
  <h1>{title}</h1>
  <ul>
    {posts.map(post => (
      <li><a href={`/${post.id.split('/').pop()?.replace(/\.[^/.]+$/, '')}`}>{post.data.title || post.id}</a></li>
    ))}
  </ul>
</WikiLayout>