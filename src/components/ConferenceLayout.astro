---
import type { RoomPresentationOption } from '../lib/live/presentation-options';

type Props = {
  livekitUrl?: string;
  courseId?: string;
  courseHomeHref?: string;
  defaultIdentity?: string;
  defaultLayout?: 'grid' | 'teacher' | 'presentation' | 'screenshare';
  defaultName?: string;
  defaultPresentation?: string;
  defaultRole?: 'teacher' | 'student';
  defaultRoom?: string;
  presentationOptions?: RoomPresentationOption[];
};

const {
  livekitUrl = '',
  courseId = '',
  courseHomeHref = '/cursos',
  defaultIdentity = '',
  defaultLayout = 'presentation',
  defaultName = '',
  defaultPresentation = '',
  defaultRole = 'student',
  defaultRoom = 'musiki-stage',
  presentationOptions = [],
} = Astro.props as Props;

const normalizedPresentationOptions = Array.isArray(presentationOptions)
  ? [...presentationOptions]
  : [];

if (
  defaultPresentation &&
  !normalizedPresentationOptions.some((option) => option.value === defaultPresentation)
) {
  normalizedPresentationOptions.unshift({
    courseId: '',
    label: defaultPresentation,
    lessonId: '',
    theme: '',
    value: defaultPresentation,
  });
}
---

<section
  class="conference-shell"
  data-conference-root
  data-livekit-url={livekitUrl}
  data-course-id={courseId}
>
  <section class="conference-stage-frame">
    <section class="conference-stage" data-stage data-layout={defaultLayout}>
      <section class="conference-stage-panel conference-stage-panel--presentation" data-panel="presentation">
        <div class="conference-stage-label">Presentation</div>
        <div class="conference-presentation">
          <iframe
            title="Presentation stage"
            data-presentation-frame
            hidden
            loading="lazy"
            allowfullscreen
          ></iframe>
          <div class="conference-empty conference-empty--presentation" data-presentation-placeholder>
            Select a lesson with theme to load Reveal.
          </div>
        </div>
      </section>

      <section class="conference-stage-panel conference-stage-panel--focus" data-panel="teacher">
        <div class="conference-stage-label">Speaker</div>
        <div
          class="conference-slot conference-slot--focus"
          data-slot="teacher"
          data-empty-label="Speaker camera"
        ></div>
      </section>

      <section class="conference-stage-panel conference-stage-panel--screen" data-panel="screen">
        <div class="conference-stage-label">Share Screen</div>
        <div
          class="conference-slot conference-slot--screen"
          data-slot="screen"
          data-empty-label="Screen share"
        ></div>
      </section>

      <section class="conference-stage-panel conference-stage-panel--grid" data-panel="grid">
        <div class="conference-stage-label">Grid</div>
        <div
          class="conference-slot conference-slot--grid"
          data-slot="grid"
          data-empty-label="Participants grid"
        ></div>
      </section>
    </section>
  </section>

  <aside class="conference-sidebar">
    <div class="conference-sidebar-scroll">
      <section class="conference-sidebar-section conference-sidebar-section--meta">
        <div class="conference-meta-shell">
          <div class="conference-meta-fields">
            <div class="conference-field">
              <label for="conference-room-input">Sala</label>
              <input id="conference-room-input" type="text" value={defaultRoom} data-room-input />
            </div>

            <div class="conference-field">
              <label for="conference-identity-input">Identity</label>
              <input
                id="conference-identity-input"
                type="text"
                value={defaultIdentity}
                data-identity-input
              />
            </div>

            <div class="conference-field">
              <label for="conference-name-input">Nombre</label>
              <div class="conference-name-row">
                <input id="conference-name-input" type="text" value={defaultName} data-name-input />
                <span class="conference-role-tag" data-role-label
                  >{defaultRole === 'teacher' ? 'teacher' : 'student'}</span
                >
              </div>
              <input type="hidden" value={defaultRole} data-role-input />
            </div>
          </div>

          <div class="conference-self-preview-shell">
            <div
              class="conference-self-preview"
              data-slot="identity-preview"
              data-empty-label="Camera preview"
            ></div>
          </div>
        </div>

        <p class="conference-statusline" data-room-status>
          Configura la sala y conecta.
        </p>
        <span class="conference-sr-only" data-room-state>Desconectado</span>
      </section>

      <section class="conference-sidebar-section">
        <div class="conference-sidebar-heading">CHAT</div>
        <div class="conference-chat">
          <ul class="conference-chat-list" data-chat-list>
            <li class="conference-chat-empty">Conecta la sala para habilitar el chat.</li>
          </ul>
          <div class="conference-chat-compose">
            <textarea rows="3" placeholder="Escribe un mensaje" data-chat-input></textarea>
            <button type="button" class="conference-chat-send" data-action="chat-send" disabled>
              Send
            </button>
          </div>
        </div>
      </section>

      <section class="conference-sidebar-section">
        <div class="conference-sidebar-heading">Students grid visual</div>
        <div
          class="conference-slot conference-slot--sidebar"
          data-slot="students"
          data-empty-label="Students"
        ></div>
      </section>
    </div>
  </aside>

  <footer class="conference-bottombar">
    <div class="conference-bar-group conference-bar-group--session">
      <button
        type="button"
        class="conference-connect-button"
        data-action="connect-toggle"
        aria-label="Conectar a la sala"
        title="Conectar"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-connect-arrow conference-connect-arrow--in">
          <path d="M4 12h12.2l-3.6-3.6 1.4-1.4L20 13l-6 6-1.4-1.4 3.6-3.6H4z" fill="currentColor"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-connect-arrow conference-connect-arrow--out">
          <path d="M20 12H7.8l3.6 3.6-1.4 1.4L4 11l6-6 1.4 1.4L7.8 10H20z" fill="currentColor"></path>
        </svg>
        <span class="conference-sr-only">Connect</span>
      </button>

      <div class="conference-count-shell">
        <button type="button" class="conference-count-button" aria-label="Participantes conectados">
          <span class="conference-count" data-participant-count data-compact="true">0</span>
        </button>
        <div class="conference-roster-popup">
          <ul class="conference-roster" data-participant-list>
            <li class="conference-roster-empty">Todavia no hay participantes en la sala.</li>
          </ul>
        </div>
      </div>

      <button
        type="button"
        class="conference-live-activity"
        data-live-activity-button
        aria-label="Abrir interacción en vivo"
        title="Abrir interacción en vivo"
        hidden
      >
        <span class="conference-live-led" aria-hidden="true"></span>
        <span class="conference-live-timer" data-live-activity-timer>--:--</span>
      </button>
    </div>

    <div class="conference-bar-group conference-bar-group--layout">
      <button type="button" class="conference-layout-button" data-layout-choice="teacher">F</button>
      <button type="button" class="conference-layout-button" data-layout-choice="screenshare">S</button>
      <button type="button" class="conference-layout-button" data-layout-choice="presentation">P</button>
      <button type="button" class="conference-layout-button" data-layout-choice="grid">G</button>
      <select class="conference-sr-only" data-layout-input aria-hidden="true" tabindex="-1">
        <option value="teacher" selected={defaultLayout === 'teacher'}>Focus</option>
        <option value="screenshare" selected={defaultLayout === 'screenshare'}>Share</option>
        <option value="presentation" selected={defaultLayout === 'presentation'}>Presentation</option>
        <option value="grid" selected={defaultLayout === 'grid'}>Grid</option>
      </select>
    </div>

    <div class="conference-bar-group conference-bar-group--controls">
      <div class="conference-device-stack">
        <button
          type="button"
          class="conference-icon-button"
          data-action="microphone"
          aria-label="Activar o silenciar microfono"
          title="Microphone. Shift + click para elegir dispositivo."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
            <path
              d="M12 15.5a3.5 3.5 0 0 0 3.5-3.5V7A3.5 3.5 0 1 0 8.5 7v5a3.5 3.5 0 0 0 3.5 3.5Zm-6-3a1 1 0 1 1 2 0 4 4 0 1 0 8 0 1 1 0 1 1 2 0 6 6 0 0 1-5 5.91V21h2a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h2v-2.59A6 6 0 0 1 6 12.5Z"
              fill="currentColor"
            />
          </svg>
          <span class="conference-mic-meter" data-mic-meter hidden></span>
          <span class="conference-sr-only">Microphone</span>
        </button>
        <div class="conference-device-panel" data-audio-input-panel hidden>
          <label for="conference-audio-input-select">Microphone</label>
          <select id="conference-audio-input-select" data-audio-input-select>
            <option value="">Selecciona un microfono</option>
          </select>
        </div>
      </div>

      <div class="conference-device-stack">
        <button
          type="button"
          class="conference-icon-button"
          data-action="camera"
          aria-label="Activar o apagar camara"
          title="Camera. Shift + click para elegir dispositivo."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
            <path
              d="M4 7.5A2.5 2.5 0 0 1 6.5 5h7A2.5 2.5 0 0 1 16 7.5v1.13l2.76-1.85A1.5 1.5 0 0 1 21 8.03v7.94a1.5 1.5 0 0 1-2.24 1.25L16 15.37v1.13A2.5 2.5 0 0 1 13.5 19h-7A2.5 2.5 0 0 1 4 16.5v-9Z"
              fill="currentColor"
            />
          </svg>
          <span class="conference-sr-only">Camera</span>
        </button>
        <div class="conference-device-panel" data-video-input-panel hidden>
          <label for="conference-video-input-select">Camera</label>
          <select id="conference-video-input-select" data-video-input-select>
            <option value="">Selecciona una camara</option>
          </select>
        </div>
      </div>

      <button
        type="button"
        class="conference-share-button"
        data-action="screen-share"
        title="Compartir pantalla"
      >
        SHARE
      </button>
    </div>

    <div class="conference-bar-group conference-bar-group--presentation">
      <label class="conference-sr-only" for="conference-presentation-select">Presentacion</label>
      <select id="conference-presentation-select" data-presentation-select>
        <option value="">none</option>
        {normalizedPresentationOptions.map((option) => (
          <option value={option.value} selected={option.value === defaultPresentation}>
            {option.label}
          </option>
        ))}
      </select>
    </div>

    <div class="conference-bar-group conference-bar-group--exit">
      <span class="conference-session-timer" data-session-timer>00:00:00</span>
      <button
        type="button"
        class="conference-record-button"
        data-action="record"
        aria-label="Grabar transmision"
        title="Grabar transmision"
      >
        <span class="conference-record-dot" aria-hidden="true"></span>
      </button>
      <a href={courseHomeHref} class="conference-exit-button" aria-label="Volver" title="Volver">
        X
      </a>
    </div>
  </footer>

  <template data-template="participant-card">
    <article class="conference-tile conference-tile--participant">
      <div class="conference-tile-media" data-card-media></div>
      <div class="conference-empty conference-empty--tile" data-card-placeholder></div>
      <footer class="conference-tile-meta">
        <strong data-card-name>Participant</strong>
      </footer>
    </article>
  </template>

  <template data-template="screen-card">
    <article class="conference-tile conference-tile--screen">
      <div class="conference-tile-media" data-screen-media></div>
      <footer class="conference-tile-meta">
        <strong data-screen-name>Screen share</strong>
        <span>Shared display</span>
      </footer>
    </article>
  </template>
</section>

<script>
  import { mountLiveKitRoom } from '../scripts/livekit-room.ts';

  let teardown = null;

  const mount = () => {
    const root = document.querySelector('[data-conference-root]');
    if (!(root instanceof HTMLElement)) return;

    if (typeof teardown === 'function') {
      teardown();
      teardown = null;
    }

    try {
      teardown = mountLiveKitRoom(root);
    } catch (error) {
      console.error('Conference room mount failed:', error);
      root.dataset.mounted = 'false';
      const status = root.querySelector('[data-room-status]');
      if (status instanceof HTMLElement) {
        status.textContent = error instanceof Error ? error.message : 'No fue posible iniciar la sala.';
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, { once: true });
  } else {
    mount();
  }

  document.addEventListener('astro:page-load', mount);
  window.addEventListener('beforeunload', () => {
    if (typeof teardown === 'function') teardown();
    teardown = null;
  });
</script>

<style>
  :global(body.room-page) {
    margin: 0;
    background: #000;
    color: #f5f7fb;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(body.room-page > main) {
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .conference-shell {
    --conference-bar-height: 42px;
    --conference-line: rgba(255, 255, 255, 0.12);
    --conference-line-soft: rgba(255, 255, 255, 0.06);
    --conference-fg: #f5f7fb;
    --conference-muted: rgba(245, 247, 251, 0.58);
    --conference-dim: rgba(245, 247, 251, 0.32);
    --conference-accent: #2a87ff;
    --conference-green: #25cf6b;
    --conference-red: #ff4d4d;
    position: relative;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 22vw);
    background: #000;
    color: var(--conference-fg);
    overflow: hidden;
    padding-bottom: var(--conference-bar-height);
  }

  .conference-stage-frame,
  .conference-sidebar {
    min-width: 0;
    min-height: 0;
    height: calc(100vh - var(--conference-bar-height));
    height: calc(100dvh - var(--conference-bar-height));
  }

  .conference-stage {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  .conference-stage-panel {
    position: absolute;
    inset: 0;
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    background: transparent;
    border-right: 1px solid var(--conference-line);
    border-bottom: 1px solid var(--conference-line);
  }

  .conference-stage-panel--presentation,
  .conference-stage-panel--focus,
  .conference-stage-panel--screen,
  .conference-stage-panel--grid {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--presentation,
  .conference-stage[data-layout='presentation'] .conference-stage-panel--focus,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen,
  .conference-stage[data-layout='grid'] .conference-stage-panel--grid {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--presentation,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen,
  .conference-stage[data-layout='grid'] .conference-stage-panel--grid {
    inset: 0;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--presentation {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--presentation .conference-stage-label {
    display: none;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--focus {
    inset: auto 1rem 1rem auto;
    width: clamp(140px, 18vw, 220px);
    aspect-ratio: 1;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-right: 1px solid rgba(255, 255, 255, 0.24);
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    overflow: hidden;
    z-index: 4;
    background: rgba(0, 0, 0, 0.92);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--focus .conference-stage-label,
  .conference-stage[data-layout='presentation'] .conference-stage-panel--screen {
    display: none;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-stage-label,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-slot--focus::before {
    display: none;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-slot--focus,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-tile,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-tile-media,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-media-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-tile {
    grid-template-rows: 1fr;
    border: 0;
    background: #000;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--focus .conference-tile-meta {
    position: absolute;
    inset: auto 0 0 0;
    border-top: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.8) 100%);
  }

  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-stage-label {
    display: none;
  }

  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-slot--screen,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-tile--screen,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-tile-media,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-media-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-tile--screen {
    grid-template-rows: 1fr;
    border: 0;
    background: #000;
  }

  .conference-stage[data-layout='screenshare'] .conference-stage-panel--screen .conference-tile-meta {
    display: none;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--focus .conference-slot--focus {
    position: absolute;
    inset: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    overflow: hidden;
  }

  .conference-stage[data-layout='presentation'] .conference-stage-panel--focus .conference-slot--focus::before {
    display: none;
  }

  .conference-stage[data-layout='teacher'] .conference-stage-panel--presentation,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--screen,
  .conference-stage[data-layout='teacher'] .conference-stage-panel--grid,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--presentation,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--focus,
  .conference-stage[data-layout='screenshare'] .conference-stage-panel--grid,
  .conference-stage[data-layout='grid'] .conference-stage-panel--presentation,
  .conference-stage[data-layout='grid'] .conference-stage-panel--focus,
  .conference-stage[data-layout='grid'] .conference-stage-panel--screen {
    display: none;
  }

  .conference-stage-label,
  .conference-sidebar-heading {
    padding: 0.45rem 0.75rem;
    color: var(--conference-muted);
    font-size: 0.66rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--conference-line);
  }

  .conference-slot,
  .conference-presentation,
  .conference-self-preview {
    min-height: 0;
    position: relative;
    display: grid;
    place-items: stretch;
    overflow: hidden;
    background: #000;
  }

  .conference-slot::before,
  .conference-self-preview::before {
    content: attr(data-empty-label);
    position: absolute;
    left: 0.8rem;
    bottom: 0.7rem;
    color: var(--conference-dim);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    pointer-events: none;
    z-index: 0;
  }

  .conference-slot:has(.conference-tile)::before,
  .conference-slot:has(.conference-media-frame)::before,
  .conference-self-preview:has(.conference-media-frame)::before {
    content: '';
  }

  .conference-slot--grid {
    padding: 0.8rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    grid-auto-rows: minmax(187px, 1fr);
    gap: 0.8rem;
    align-content: start;
    overflow: auto;
  }

  .conference-slot--sidebar {
    min-height: 15rem;
    max-height: 30vh;
    padding: 0.2rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
    gap: 0.55rem;
    align-content: start;
    overflow: auto;
  }

  .conference-presentation iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .conference-empty {
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--conference-dim);
    text-align: center;
    line-height: 1.45;
  }

  .conference-empty--tile {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .conference-empty[hidden],
  .conference-presentation > iframe[hidden],
  .conference-presentation > .conference-empty--presentation[hidden] {
    display: none !important;
  }

  .conference-sidebar {
    border-left: 1px solid var(--conference-line);
  }

  .conference-sidebar-scroll {
    height: 100%;
    overflow-y: auto;
    background: transparent;
    overscroll-behavior: contain;
  }

  .conference-sidebar-section {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem 0.9rem;
    border-bottom: 1px solid var(--conference-line);
  }

  .conference-meta-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 112px;
    gap: 0.8rem;
    align-items: start;
  }

  .conference-meta-fields {
    display: grid;
    gap: 0.6rem;
  }

  .conference-field {
    display: grid;
    gap: 0.28rem;
